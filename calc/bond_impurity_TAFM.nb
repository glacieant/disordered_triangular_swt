Cell[CellGroupData[{
Cell["\<\
The bond impurity problem in triangular lattice heisenberg AFM\
\>", "Section",
 CellChangeTimes->{{3.713588188948265*^9, 3.713588260616188*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"gamma", "[", 
   RowBox[{"kx_", ",", "ky_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", "kx", "]"}], "+", 
     RowBox[{"2", 
      RowBox[{"Cos", "[", 
       RowBox[{"ky", "/", "3"}], "]"}], 
      RowBox[{"Cos", "[", 
       RowBox[{
        SqrtBox["3"], 
        RowBox[{"ky", "/", "2"}]}], "]"}]}]}], ")"}], "/", "3"}]}]], "Input",
