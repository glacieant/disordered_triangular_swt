Cell[CellGroupData[{

Cell["\<\
Bond impurity in anisotropy model\
\>", "Section",
 CellChangeTimes->{{3.713769682116219*^9, 3.7137697300189238`*^9}, {
  3.718359845393615*^9, 3.718359872992887*^9}}],

Cell[CellGroupData[{

Cell["\<\
Referencing Andrade et. al XY antiferromagnet with quenched disorder\
\>", "Subsection",
 CellChangeTimes->{{3.718359886704729*^9, 3.71835992262367*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   FractionBox[
    SuperscriptBox["q", 
     RowBox[{"d", "-", "1"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "+", 
       RowBox[{
        SuperscriptBox["k", "2"], " ", 
        SuperscriptBox["q", "2"]}]}], ")"}], "2"]], ",", 
   RowBox[{"{", 
    RowBox[{"q", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "\[Rule]", " ", "Reals"}], ",", 
      RowBox[{"d", "\[Rule]", " ", "Reals"}], ",", 
      RowBox[{"k", "\[Rule]", " ", "Reals"}], ",", 
      RowBox[{"k", "\[NotEqual]", " ", "0"}], ",", 
      RowBox[{"\[Lambda]", " ", "\[NotEqual]", " ", "0"}], ",", 
      RowBox[{"d", "\[NotEqual]", " ", "0"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.718359941169729*^9, 3.718360008107142*^9}, {
   3.7183601474317503`*^9, 3.718360189936912*^9}, {3.718360228232883*^9, 
   3.7183602753036947`*^9}, 3.71836049909062*^9}],

Cell[BoxData[
 RowBox[{"ConditionalExpression", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     FractionBox["\[Lambda]", 
      RowBox[{
       SuperscriptBox["k", "2"], "+", "\[Lambda]"}]], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox["2", "d"]}], ")"}], " ", 
      RowBox[{"Hypergeometric2F1", "[", 
       RowBox[{"1", ",", 
        FractionBox["d", "2"], ",", 
        FractionBox[
         RowBox[{"2", "+", "d"}], "2"], ",", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["k", "2"], "\[Lambda]"]}]}], "]"}]}]}], 
    RowBox[{"2", " ", 
     SuperscriptBox["\[Lambda]", "2"]}]], ",", 
   RowBox[{
    RowBox[{"Re", "[", "d", "]"}], ">", "0"}]}], "]"}]], "Output",
 CellChangeTimes->{3.718360013947501*^9, 3.718360194569772*^9, 
  3.718360234863576*^9, 3.718360279687558*^9, 3.718360505306622*^9}]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Mass term in spin-wave dispersion anisotropic triangular lattice Heisenberg \
model\
\>", "Subsection",
 CellChangeTimes->{{3.718365958461527*^9, 3.7183659905157843`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]", " ", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["S", "i"], "z"], ".", 
      SuperscriptBox[
       SubscriptBox["S", "j"], "z"]}]}], "+", 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["S", "i"], "x"], ".", 
       SuperscriptBox[
        SubscriptBox["S", "j"], "x"]}], "+", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["S", "i"], "y"], ".", 
       SuperscriptBox[
        SubscriptBox["S", "j"], "y"]}]}], ")"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["S", "i"], "z"], "\[Rule]", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "i"], "z"], 
        RowBox[{"Cos", "[", 
         SubscriptBox["\[Theta]", "i"], "]"}]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "i"], "x"], 
        RowBox[{"Sin", "[", 
         SubscriptBox["\[Theta]", "i"], "]"}]}]}]}], ",", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["S", "i"], "x"], "\[Rule]", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "i"], "z"], 
        RowBox[{"Sin", "[", 
         SubscriptBox["\[Theta]", "i"], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "i"], "x"], 
        RowBox[{"Cos", "[", 
         SubscriptBox["\[Theta]", "i"], "]"}]}]}]}], ",", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["S", "j"], "z"], "\[Rule]", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "j"], "z"], 
        RowBox[{"Cos", "[", 
         SubscriptBox["\[Theta]", "j"], "]"}]}], "-", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "j"], "x"], 
        RowBox[{"Sin", "[", 
         SubscriptBox["\[Theta]", "j"], "]"}]}]}]}], ",", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["S", "j"], "x"], "\[Rule]", " ", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "j"], "z"], 
        RowBox[{"Sin", "[", 
         SubscriptBox["\[Theta]", "j"], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["S", "j"], "x"], 
        RowBox[{"Cos", "[", 
         SubscriptBox["\[Theta]", "j"], "]"}]}]}]}]}], "}"}]}], ",", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SuperscriptBox[
      SubscriptBox["S", "i"], "x"], ",", 
     SuperscriptBox[
      SubscriptBox["S", "i"], "y"], ",", 
     SuperscriptBox[
      SubscriptBox["S", "i"], "z"], ",", 
     SuperscriptBox[
      SubscriptBox["S", "j"], "x"], ",", 
     SuperscriptBox[
      SubscriptBox["S", "j"], "y"], ",", 
     SuperscriptBox[
      SubscriptBox["S", "j"], "z"]}], "}"}], "/.", " ", 
   RowBox[{"{", "S", "}"}]}]}]], "Input",
 CellChangeTimes->{{3.718366062857691*^9, 3.7183663679299803`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubsuperscriptBox["S", "i", "y"], ".", 
   SubsuperscriptBox["S", "j", "y"]}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sin", "[", 
         SubscriptBox["\[Theta]", "i"], "]"}]}], " ", 
       SubsuperscriptBox["S", "i", "x"]}], "+", 
      RowBox[{
       RowBox[{"Cos", "[", 
        SubscriptBox["\[Theta]", "i"], "]"}], " ", 
       SubsuperscriptBox["S", "i", "z"]}]}], ")"}], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Sin", "[", 
         SubscriptBox["\[Theta]", "j"], "]"}]}], " ", 
       SubsuperscriptBox["S", "j", "x"]}], "+", 
      RowBox[{
       RowBox[{"Cos", "[", 
        SubscriptBox["\[Theta]", "j"], "]"}], " ", 
       SubsuperscriptBox["S", "j", "z"]}]}], ")"}]}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       SubscriptBox["\[Theta]", "i"], "]"}], " ", 
      SubsuperscriptBox["S", "i", "x"]}], "+", 
     RowBox[{
      RowBox[{"Sin", "[", 
       SubscriptBox["\[Theta]", "i"], "]"}], " ", 
      SubsuperscriptBox["S", "i", "z"]}]}], ")"}], ".", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       SubscriptBox["\[Theta]", "j"], "]"}], " ", 
      SubsuperscriptBox["S", "j", "x"]}], "+", 
     RowBox[{
      RowBox[{"Sin", "[", 
       SubscriptBox["\[Theta]", "j"], "]"}], " ", 
      SubsuperscriptBox["S", "j", "z"]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.718366224613693*^9, 3.7183662964082403`*^9, 
  3.718366340372106*^9}]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Correlation function of the massed scalar theory\
\>", "Section",
 CellChangeTimes->{{3.719038653033972*^9, 3.719038660992951*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox["q", 
      RowBox[{"d", "-", "1"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["q", "2"], "+", 
        SuperscriptBox["m", "2"]}], ")"}], "2"]], 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "q", " ", "x"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"q", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "\[Rule]", " ", "Reals"}], ",", 
      RowBox[{"d", "\[Rule]", " ", "Reals"}], ",", 
      RowBox[{"x", "\[Rule]", " ", "Reals"}], ",", 
      RowBox[{"m", ">", " ", "0"}], ",", 
      RowBox[{"d", ">", " ", "0"}], ",", 
      RowBox[{"x", ">", "0"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7190387537751913`*^9, 3.7190388388290253`*^9}, {
  3.719038870557438*^9, 3.719038879532909*^9}}],

Cell[BoxData[
 RowBox[{"ConditionalExpression", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["x", 
     RowBox[{"-", "d"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["x", "4"], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "4"}], "+", "d"}], "]"}], " ", 
       RowBox[{"HypergeometricPFQ", "[", 
        RowBox[{
         RowBox[{"{", "2", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            FractionBox["5", "2"], "-", 
            FractionBox["d", "2"]}], ",", 
           RowBox[{"3", "-", 
            FractionBox["d", "2"]}]}], "}"}], ",", 
         FractionBox[
          RowBox[{
           SuperscriptBox["m", "2"], " ", 
           SuperscriptBox["x", "2"]}], "4"]}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cos", "[", 
          FractionBox[
           RowBox[{"d", " ", "\[Pi]"}], "2"], "]"}], "+", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"Sin", "[", 
           FractionBox[
            RowBox[{"d", " ", "\[Pi]"}], "2"], "]"}]}]}], ")"}]}], "-", 
      FractionBox[
       RowBox[{"\[Pi]", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"m", " ", "x"}], ")"}], "d"], " ", 
        RowBox[{"Csc", "[", 
         RowBox[{"d", " ", "\[Pi]"}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "d"}], ")"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{
             FractionBox[
              RowBox[{"d", " ", "\[Pi]"}], "2"], "-", 
             RowBox[{"\[ImaginaryI]", " ", "m", " ", "x"}]}], "]"}]}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "m", " ", "x", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             FractionBox[
              RowBox[{"d", " ", "\[Pi]"}], "2"], "-", 
             RowBox[{"\[ImaginaryI]", " ", "m", " ", "x"}]}], "]"}]}]}], 
         ")"}]}], 
       SuperscriptBox["m", "4"]]}], ")"}]}], ",", 
   RowBox[{"d", "<", "5"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.7190388001632013`*^9, 3.719038818072857*^9}, 
   3.719038856325838*^9, 3.7190388957254267`*^9}]
}, Open  ]]
}, Open  ]]
}, Open  ]]
