  3.717923475464913*^9, 3.717923475464973*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"qx_", ",", "qy_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Cos", "[", "qx", "]"}], "+", 
   RowBox[{"Cos", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "qx"}], "+", 
      RowBox[{
       SqrtBox["3"], "qy"}]}], "2"], "]"}]}]}]], "Input",
