Cell[CellGroupData[{

Cell["\<\
Perturbative treatment for (1,0)\
\>", "Subsection",
 CellChangeTimes->{{3.717925685916027*^9, 3.717925706954977*^9}, {
  3.7179258711110353`*^9, 3.7179258754626837`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"qx_", ",", "qy_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "t"}], ")"}], 
    RowBox[{"Cos", "[", "qx", "]"}]}], "+", 
   RowBox[{"2", 
    RowBox[{"Cos", "[", 
     FractionBox["qx", "2"], "]"}], 
    RowBox[{"Cos", "[", 
     FractionBox[
      RowBox[{"qy", 
       SqrtBox["3"]}], "2"], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.717921077459639*^9, 3.717921084138836*^9}, 
   3.717922965898889*^9, {3.717923164013482*^9, 3.717923191525199*^9}, {
   3.7179234718145647`*^9, 3.717923480317068*^9}, {3.717925089745718*^9, 
   3.71792511525766*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"F", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"4", "\[Pi]"}], "3"], "+", "x"}], ",", "y", ",", "t"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"4", " ", "\[Pi]"}], "3"], "+", "x"}], ")"}]}], "]"}], " ", 
   RowBox[{"Cos", "[", 
    FractionBox[
     RowBox[{
      SqrtBox["3"], " ", "y"}], "2"], "]"}]}], "-", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", "t"}], ")"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{
     FractionBox["\[Pi]", "6"], "-", "x"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.717926014175707*^9, 3.717926198417016*^9}]
}, Open  ]],

