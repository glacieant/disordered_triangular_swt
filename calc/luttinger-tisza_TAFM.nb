Cell[CellGroupData[{

Cell["Anomalous dipole density", "Section",
 CellChangeTimes->{{3.717917802477468*^9, 3.717917812924535*^9}}],

Cell[CellGroupData[{

Cell["For uniform lattice", "Subsection",
 CellChangeTimes->{{3.7179178229172153`*^9, 3.717917838349313*^9}, {
  3.717921225908646*^9, 3.7179212354200697`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"qx_", ",", "qy_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Cos", "[", "qx", "]"}], "+", 
   RowBox[{"2", 
    RowBox[{"Cos", "[", 
     RowBox[{"qx", "/", "2"}], "]"}], 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"qy", 
        RowBox[{"\[Sqrt]", "3"}]}], ")"}], "/", "2"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.717921077459639*^9, 3.717921084138836*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"S1", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "a"}], ",", 
     RowBox[{"y", "\[Rule]", " ", "b"}]}], "}"}]}]}]], "Input",
