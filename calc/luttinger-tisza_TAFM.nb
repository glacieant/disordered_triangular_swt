Cell[CellGroupData[{

Cell["\<\
For anomalous dipole along (1,0)\
\>", "Subsection",
 CellChangeTimes->{{3.7179178229172153`*^9, 3.717917838349313*^9}, {
  3.717921225908646*^9, 3.7179212354200697`*^9}, {3.7179229428646603`*^9, 
  3.717922960176011*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"qx_", ",", "qy_"}], "]"}], ":=", 
  RowBox[{"2", 
   RowBox[{"Cos", "[", 
    RowBox[{"qx", "/", "2"}], "]"}], 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"qy", 
       RowBox[{"\[Sqrt]", "3"}]}], ")"}], "/", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.717921077459639*^9, 3.717921084138836*^9}, 
   3.717922965898889*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"S1", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "a"}], ",", 
     RowBox[{"y", "\[Rule]", " ", "b"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{
  3.71792081007333*^9, {3.7179210884826183`*^9, 3.7179210886741*^9}, {
   3.717922365345924*^9, 3.717922371913553*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"S2", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
