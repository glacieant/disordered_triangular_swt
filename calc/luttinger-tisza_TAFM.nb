Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "The Luttinger-Tisza Method for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "1"], " ", "-", 
    SubscriptBox["J", "2"]}], TraditionalForm]]],
 " Triangular Lattice Anti-ferromagnet"
}], "Title",
 CellChangeTimes->{{3.71707120275263*^9, 3.717071249666197*^9}}],

Cell[CellGroupData[{

Cell["The Minimization function", "Section",
 CellChangeTimes->{{3.717071276961926*^9, 3.7170712827371693`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"e1", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], ",", 
     RowBox[{
      RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e4", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      SqrtBox["3"], "2"], ",", 
     FractionBox["1", "2"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e5", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e6", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        SqrtBox["3"], "2"]}], ",", 
      FractionBox["1", "2"]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"qx_", ",", "qy_", ",", "alpha_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"0", 
    RowBox[{"Cos", "[", "qx", "]"}]}], "+", 
   RowBox[{"2", 
    RowBox[{"Cos", "[", 
     FractionBox["qx", "2"], "]"}], 
    RowBox[{"Cos", "[", 
     FractionBox[
      RowBox[{"qy", 
       SqrtBox["3"]}], "2"], "]"}]}], "+", 
   RowBox[{"alpha", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"qy", 
        SqrtBox["3"]}], "]"}], "+", 
      RowBox[{"2", 
       RowBox[{"Cos", "[", 
        RowBox[{"3", 
         FractionBox["qx", "2"]}], "]"}], 
       RowBox[{"Cos", "[", 
        FractionBox[
         RowBox[{"qy", 
          SqrtBox["3"]}], "2"], "]"}]}]}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.717071258896159*^9, 3.717071267246573*^9}, {
  3.717071367446644*^9, 3.717071480785242*^9}, {3.717072100432046*^9, 
  3.7170721607290688`*^9}, {3.717072205791749*^9, 3.717072347595501*^9}, {
  3.717478408302285*^9, 3.717478521188846*^9}, {3.71791667729091*^9, 
  3.717916694995496*^9}, {3.717916803735526*^9, 3.717916816406316*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"F", "[", 
    RowBox[{"qx", ",", "qy", ",", "0.0"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"qx", ",", 
     RowBox[{
      RowBox[{"-", "2"}], "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"qy", ",", 
     RowBox[{
      RowBox[{"-", "2"}], "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", "True"}], ",", 
   RowBox[{"ViewPoint", "\[Rule]", "Top"}]}], "]"}]], "Input",
