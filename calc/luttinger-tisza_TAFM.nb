Cell[CellGroupData[{

Cell["For anisotropic lattice", "Subsection",
 CellChangeTimes->{{3.7179178229172153`*^9, 3.717917838349313*^9}, {
   3.717921225908646*^9, 3.7179212354200697`*^9}, {3.7179229428646603`*^9, 
   3.717922960176011*^9}, 3.725717974475944*^9, {3.725718007714637*^9, 
   3.7257180154668922`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{
   "qx_", ",", "qy_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "\[Gamma]_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
    RowBox[{"Cos", "[", "qx", "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Beta]"}], ")"}], 
    RowBox[{"Cos", "[", 
     RowBox[{
      FractionBox["qx", "2"], "+", 
      FractionBox[
       RowBox[{
        SqrtBox["3"], "qy"}], "2"]}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Gamma]"}], ")"}], 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["qx", "2"]}], "+", 
      FractionBox[
       RowBox[{
        SqrtBox["3"], "qy"}], "2"]}], "]"}]}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindMinimum", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"F", "[", 
