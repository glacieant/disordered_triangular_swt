Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"qx_", ",", "qy_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Cos", "[", "qx", "]"}], "+", 
   RowBox[{"2", 
    RowBox[{"Cos", "[", 
     RowBox[{"qx", "/", "2"}], "]"}], 
    RowBox[{"Cos", "[", 
