Cell[BoxData[
 RowBox[{"SOLN1", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"S1", "[", 
       RowBox[{"a", ",", "b", ",", "t"}], "]"}], "==", "0"}], "&&", 
