Cell[BoxData[
 RowBox[{"Normal", "[", 
  RowBox[{"Series", "[", 
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"], "+", "x"}], ",", "y", ",", "t"}], "]"}],
