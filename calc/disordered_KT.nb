Cell[BoxData[
 RowBox[{
  RowBox[{"TD", "[", 
   RowBox[{
    RowBox[{"\[CapitalDelta]0_", "?", "NumericQ"}], ",", 
    RowBox[{"T0_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"First", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"T", ",", "g"}], "}"}], "/.", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"T", "'"}], "[", "l", "]"}], "\[Equal]", 
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"g", "[", "l", "]"}], "2"]}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "'"}], "[", "l", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"2", "-", 
               RowBox[{
                FractionBox["1", "2"], 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["1", 
                   RowBox[{"T", "[", "l", "]"}]], "-", 
                  FractionBox[
                   SuperscriptBox["\[CapitalDelta]0", "2"], 
                   SuperscriptBox[
                    RowBox[{"T", "[", "l", "]"}], "2"]]}], ")"}]}]}], ")"}]}], 
            RowBox[{"g", "[", "l", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"T", "[", "1", "]"}], "\[Equal]", "T0"}], ",", 
          RowBox[{
           RowBox[{"g", "[", "1", "]"}], "==", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "g"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], "[", "0.0", "]"}]}]], "Input",
