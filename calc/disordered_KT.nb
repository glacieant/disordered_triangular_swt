          RowBox[{
           RowBox[{
            RowBox[{"T", "'"}], "[", "l", "]"}], "\[Equal]", 
           SuperscriptBox[
            RowBox[{"g", "[", "l", "]"}], "2"]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "'"}], "[", "l", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "-", 
              RowBox[{
               FractionBox["1", "2"], 
               RowBox[{"(", 
                RowBox[{
                 FractionBox["1", 
                  RowBox[{"T", "[", "l", "]"}]], "-", 
                 FractionBox[
                  SuperscriptBox["\[CapitalDelta]0", "2"], 
                  SuperscriptBox[
                   RowBox[{"T", "[", "l", "]"}], "2"]]}], ")"}]}]}], ")"}], 
            RowBox[{"g", "[", "l", "]"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"T", "[", "0.0", "]"}], "\[Equal]", "T0"}], ",", 
          RowBox[{
           RowBox[{"g", "[", "0.0", "]"}], "==", "1.0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "g"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "0.0", ",", "1.0"}], "}"}]}], "]"}]}], "]"}], "[", 
    
