Cell[BoxData[
 RowBox[{
  RowBox[{"TD", "[", 
   RowBox[{
    RowBox[{"\[CapitalDelta]0_", "?", "NumericQ"}], ",", 
    RowBox[{"T0_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"First", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"T", ",", "g"}], "}"}], "/.", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
