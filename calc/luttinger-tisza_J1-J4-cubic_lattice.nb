Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "The Luttinger-Tisza Method for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["J", "1"], " ", "-", 
    SubscriptBox["J", "4"]}], TraditionalForm]]],
 " Cubic Lattice Anti-ferromagnet"
}], "Title",
 CellChangeTimes->{{3.71707120275263*^9, 3.717071249666197*^9}, {
  3.720187063364675*^9, 3.720187065043989*^9}, {3.726304682098708*^9, 
  3.726304685406361*^9}}],

Cell[CellGroupData[{

Cell["Energy landscape", "Section",
 CellChangeTimes->{{3.717917802477468*^9, 3.717917812924535*^9}, {
  3.7201870780550137`*^9, 3.720187192628978*^9}, {3.720187346133244*^9, 
