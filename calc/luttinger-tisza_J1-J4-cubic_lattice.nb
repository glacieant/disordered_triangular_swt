  3.7263077219765997`*^9, 3.7263077255441313`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"EF", "[", 
   RowBox[{"J1_", ",", "J4_", ",", "qx_", ",", "qy_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"2", "J1", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", "qx", "]"}], "+", 
      RowBox[{"Cos", "[", "qy", "]"}]}], ")"}]}], "+", 
   RowBox[{"2", "J4", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"2", "qx"}], "]"}], "+", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", "qy"}], "]"}]}], ")"}]}]}]}]], "Input",
