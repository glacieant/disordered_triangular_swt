# Generic makefile for projects with SRC, BIN, OBJ 
# hierarchy

# setting the shell environment
SHELL = /bin/bash

# setting directories
SRCDIR = SRC
INCDIR = INC
OBJDIR = OBJ
BINDIR = BIN

# compilation environment
CC = gcc
CFLAGS = -O3 -std=c99
#CFLAGS = -g -O0
#LFLAGS = -lm -L/opt/intel/lib/intel64 -L/opt/intel/mkl/lib/intel64 \
	 -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 \
	 -lpthread -lfftw3 -lblas -fopenmp
LFLAGS = -lm -llapack -lfftw3 -lblas -fopenmp
INCDIRS = -I${INCDIR}


SOURCES  = $(wildcard $(SRCDIR)/*.c)
INCS  = $(wildcard $(INCDIR)/*.h)
OBJECTS  = $(SOURCES:$(SRCDIR)/%.c=$(OBJDIR)/%.o)
TARGET = $(BINDIR)/#EXEC# 
rm       = rm -f

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) $(CFLAGS) $(LFLAGS) $(INCDIRS) -o $(TARGET)

$(OBJDIR)/%.o : $(SRCDIR)/%.c $(INCS)
	$(CC) -c $(CFLAGS) $(LFLAGS) $(INCDIRS) $< -o $@

clean:
	$(rm) $(OBJDIR)/*.o $(BINDIR)/*.x
